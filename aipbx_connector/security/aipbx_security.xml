<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_aipbx" model="ir.module.category">
        <field name="name">AiPBX</field>
        <field name="sequence">60</field>
    </record>
    <record id="group_aipbx_user" model="res.groups">
        <field name="name">User: own calls</field>
        <field name="category_id" ref="module_category_aipbx"/>
    </record>
    <record id="group_aipbx_manager" model="res.groups">
        <field name="name">Administrator: all calls and the connection</field>
        <field name="category_id" ref="module_category_aipbx"/>
        <field name="implied_ids" eval="[(4, ref('group_aipbx_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_aipbx_user'))]"/>
    </record>

    <record id="rule_aipbx_call_own" model="ir.rule">
        <field name="name">AiPBX: own calls</field>
        <field name="model_id" ref="model_aipbx_call"/>
        <field name="domain_force">['&amp;', ('company_id', 'in', company_ids), '|', ('user_id', '=', user.id), ('offered_user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('group_aipbx_user'))]"/>
    </record>
    <record id="rule_aipbx_call_all" model="ir.rule">
        <field name="name">AiPBX: all calls of the allowed companies</field>
        <field name="model_id" ref="model_aipbx_call"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_aipbx_manager'))]"/>
    </record>
    <record id="rule_aipbx_connection_company" model="ir.rule">
        <field name="name">AiPBX: connections of the allowed companies</field>
        <field name="model_id" ref="model_aipbx_connection"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_aipbx_extension_company" model="ir.rule">
        <field name="name">AiPBX: extensions of the allowed companies</field>
        <field name="model_id" ref="model_aipbx_extension"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_aipbx_event_company" model="ir.rule">
        <field name="name">AiPBX: events of the allowed companies</field>
        <field name="model_id" ref="model_aipbx_event"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
