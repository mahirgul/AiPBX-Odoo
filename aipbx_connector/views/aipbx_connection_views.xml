<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aipbx_connection_tree" model="ir.ui.view">
        <field name="name">aipbx.connection.tree</field>
        <field name="model">aipbx.connection</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="pbx_url"/>
                <field name="state" widget="badge" decoration-success="state == 'ready'"/>
                <field name="last_event_at"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_aipbx_connection_form" model="ir.ui.view">
        <field name="name">aipbx.connection.form</field>
        <field name="model">aipbx.connection</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_pack_wizard" type="object" string="Paste connection pack" class="btn-primary" invisible="state == 'ready'"/>
                    <button name="action_open_pack_wizard" type="object" string="Paste a new pack" invisible="state != 'ready'"/>
                    <button name="action_test" type="object" string="Test" invisible="state != 'ready'"/>
                    <button name="action_sync_extensions" type="object" string="Bring in extensions" invisible="state != 'ready'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="outside_key">
                        The PBX key and webhook secret are encrypted with a key kept in this database.
                        For a key outside it, set <code>aipbx_secret_key</code> in the Odoo configuration file and paste the pack again.
                    </div>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. Head office PBX"/></h1></div>
                    <group>
                        <group>
                            <field name="pbx_url"/>
                            <field name="connection_uuid"/>
                            <field name="webhook_url" widget="CopyClipboardChar"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="outside_key" invisible="1"/>
                        </group>
                        <group>
                            <field name="missed_call_user_id"/>
                            <field name="last_event_at"/>
                            <field name="last_test_at"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Extensions and users">
                            <field name="extension_ids">
                                <list editable="bottom" create="0">
                                    <field name="extension" readonly="1"/>
                                    <field name="name" readonly="1"/>
                                    <field name="email" readonly="1"/>
                                    <field name="user_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_aipbx_connection" model="ir.actions.act_window">
        <field name="name">Connections</field>
        <field name="res_model">aipbx.connection</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Connect your AiPBX phone system</p>
            <p>Create a connection here, then on the PBX: Integration &gt; Connections &gt; New connection (kind Odoo) and paste the pack it shows.</p>
        </field>
    </record>
</odoo>
