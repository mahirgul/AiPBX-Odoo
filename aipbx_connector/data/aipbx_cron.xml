<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_aipbx_retry_events" model="ir.cron">
        <field name="name">AiPBX: retry failed events</field>
        <field name="model_id" ref="model_aipbx_event"/>
        <field name="state">code</field>
        <field name="code">model._cron_retry()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
    </record>
    <record id="cron_aipbx_push_contacts" model="ir.cron">
        <field name="name">AiPBX: send contacts to the PBX address book</field>
        <field name="model_id" ref="model_aipbx_connection"/>
        <field name="state">code</field>
        <field name="code">model._cron_push_contacts()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
    </record>
</odoo>
