<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_aipbx" model="ir.ui.view">
        <field name="name">crm.lead.form.aipbx</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_aipbx_calls" type="object" class="oe_stat_button" icon="fa-phone" groups="aipbx_connector.group_aipbx_user">
                    <field name="aipbx_call_count" widget="statinfo" string="Calls"/>
                </button>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_aipbx_call" type="object" string="Call" icon="fa-phone" groups="aipbx_connector.group_aipbx_user"/>
            </xpath>
        </field>
    </record>
</odoo>
